<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Modified 2026 by Future History Labs: this is a custom Info.plist for the
  fork (based verbatim on Qt's own default template, macx-clang/Info.plist.app,
  so bundling behaves identically) — added CFBundleName/CFBundleDisplayName so
  macOS chrome that reads bundle metadata directly (Dock, Cmd+Tab, Finder,
  Spotlight) shows "FHL-Fallout" instead of falling back to the executable
  name "cool-retro-term", and NSHumanReadableCopyright so Finder's "Get Info"
  credits both the original author and this fork's modifications.
-->
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>${EXECUTABLE_NAME}</string>
	<key>CFBundleName</key>
	<string>FHL-Fallout</string>
	<key>CFBundleDisplayName</key>
	<string>FHL-Fallout</string>
	<key>CFBundleIconFile</key>
	<string>${ASSETCATALOG_COMPILER_APPICON_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${PRODUCT_BUNDLE_IDENTIFIER}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>${QMAKE_PKGINFO_TYPEINFO}</string>
	<key>LSMinimumSystemVersion</key>
	<string>${MACOSX_DEPLOYMENT_TARGET}</string>
	<key>NSHumanReadableCopyright</key>
	<string>cool-retro-term (c) 2013-2025 Filippo Scognamiglio. FHL-Fallout modifications (c) 2026 Future History Labs. GPLv3-or-later.</string>
	<key>NOTE</key>
	<string>This file was generated by Qt/QMake.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
</dict>
</plist>
